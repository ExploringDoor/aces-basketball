{
  "functions": {
    "api/reconcile.js": {
      "maxDuration": 120
    },
    "api/remind.js": {
      "maxDuration": 120
    },
    "api/notify.js": {
      "maxDuration": 60
    },
    "api/newsletter.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/remind",
      "schedule": "0 20 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/playbook",
      "destination": "/playbook.html",
      "permanent": false
    },
    {
      "source": "/playbook-admin",
      "destination": "/playbook-admin.html",
      "permanent": false
    }
  ]
}
