{
  "functions": {
    "api/reconcile.js": {
      "maxDuration": 120
    },
    "api/remind.js": {
      "maxDuration": 120
    },
    "api/notify.js": {
      "maxDuration": 60
    },
    "api/newsletter.js": {
      "maxDuration": 300
    },
    "api/alerts.js": {
      "maxDuration": 120
    },
    "api/playbook-feedwatch.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/remind",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/playbook-digest",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/playbook-feedwatch",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:page(news|clinics|store|standings|history|thousand|schedule|story|championships|banners|rivalry|headtohead|seasons|nextlevel|numbers|league|alumni|coaching|roster|records|photos|videos|kobe|social|hof|support|youth|academics|sponsors|flyers|scores|scouting|practice|newsletter)/",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/playbook",
      "destination": "/playbook.html",
      "permanent": false
    },
    {
      "source": "/playbook-admin",
      "destination": "/playbook-admin.html",
      "permanent": false
    },
    {
      "source": "/alerts",
      "destination": "/alerts.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:page(news|clinics|store|standings|history|thousand|schedule|story|championships|banners|rivalry|headtohead|seasons|nextlevel|numbers|league|alumni|coaching|roster|records|photos|videos|kobe|social|hof|support|youth|academics|sponsors|flyers|scores|scouting|practice|newsletter)",
      "destination": "/:page.html"
    },
    {
      "source": "/attitude",
      "destination": "https://attitude-board.vercel.app/"
    },
    {
      "source": "/attitude/",
      "destination": "https://attitude-board.vercel.app/"
    },
    {
      "source": "/attitude/:path*",
      "destination": "https://attitude-board.vercel.app/:path*"
    },
    {
      "source": "/icons/:path*",
      "destination": "https://attitude-board.vercel.app/icons/:path*"
    }
  ]
}
